{
  "expo": {
    "name": "HunterX",
    "slug": "shakthi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hunterx",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E17",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hunterx.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "HunterX lets you choose photos from your library to submit as quest proof or attach to feedback."
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "package": "com.hunterx.mobile",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE"
      ],
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "HunterX does not use Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 256
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "HunterX does not record audio. iOS asks for this because the app's media features include audio support."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "HunterX lets you choose photos from your library to submit as quest proof or attach to feedback.",
          "cameraPermission": "HunterX does not use your camera. Photos for quest proof and feedback are chosen from your photo library.",
          "microphonePermission": "HunterX does not record audio. iOS asks for this because the app's media features include audio support."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.991893509642-1mpn4fs7gm814s1v0cvjsd4cqfk5klh6"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "HunterX reads your steps, active calories, distance, heart rate, sleep and workouts to track your fitness progress and complete health-based quests.",
          "NSHealthUpdateUsageDescription": "HunterX does not save or change any data in Apple Health. It only reads your activity to track quest progress.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FE5B01"
        }
      ],
      "./plugins/withXcode27Compat"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c22f478-6a62-4a5f-99a0-d8cc4e697584"
      }
    },
    "owner": "hunterxtechs-team"
  }
}
