{
  "cli": {
    "version": ">= 21.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-uat.hunterx.co.in/api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "apk-local": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://192.168.1.12:5001/api",
        "ALLOW_CLEARTEXT_HTTP": "true",
        "EXPO_PUBLIC_PUSH_DEBUG": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "testflight": {
      "extends": "production",
      "environment": "preview",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-uat.hunterx.co.in/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6831613229"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6831613229"
      }
    }
  }
}
