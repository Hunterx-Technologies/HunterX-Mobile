# Local URL
# EXPO_PUBLIC_API_URL=http://192.168.1.11:5001/api
# EXPO_PUBLIC_API_URL=http://localhost:5001/api

# UAT URL
EXPO_PUBLIC_API_URL=https://api-uat.hunterx.co.in/api
# Domain serving Guest Pass referral links (https://<host>/guestpass/<code>)
EXPO_PUBLIC_REFERRAL_LINK_HOST=join.hunterx.app

# Production URL
# EXPO_PUBLIC_API_URL=https://api.hunterx.co.in/api

# Google OAuth — Web + iOS client IDs from Google Cloud Console (must match
# HunterX-Backend's GOOGLE_CLIENT_ID_WEB/_IOS). Android needs no client ID
# here — it's matched automatically via package name + SHA-1 fingerprint.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=

PORT=8081
